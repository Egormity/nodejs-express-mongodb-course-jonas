    //     "^@/assets/constants(.*)$",
    //     "^@/assets/hooks(.*)$",
    //     "^@/assets/ui(.*)$",
    //     "^@/assets/utils(.*)$",
    //     "^@/widgets/(.*)$",
    //     "^../(.*)$",
    //     "^./(.*)$",
    //     "(.scss)$"
    // ],
    // "importOrderSeparation": true,
    // "importOrderSortSpecifiers": true
}
