{
    // "plugins": ["@trivago/prettier-plugin-sort-imports"],

    "printWidth": 110,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "requirePragma": false,
    "insertPragma": false,
    "proseWrap": "preserve",
    "htmlWhitespaceSensitivity": "css",
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": true

    // "importOrder": [
    //     "<THIRD_PARTY_MODULES>",
    //     "^@/app/apis(.*)$",
    //     "^@/app/navigation(.*)$",
