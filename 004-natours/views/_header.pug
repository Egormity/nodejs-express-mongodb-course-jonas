header.header
    nav.nav.nav--tours
        a.nav__el(href="/") All tours
    .header__logo
        img(src="/img/logo-white.png" alt="Natour logo")
    nav.nav.nav--user
        if user
            a.nav__el.nav__el--logout Log out
            a.nav__el(href="#")
                img(src=`/img/users/${user.photo}` alt=`${user.name} photo`)
                span=user.name.split("")[0]
        else
            a.nav__el(href="/login") Log in
            //- button.nav__el.nav__el--cta Sign up